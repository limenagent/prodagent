# ── Incident context (aiops/config.py) ────────────────────────────────────────
# Set these to pre-populate the incident prompt at startup.
INCIDENT_ID=
INCIDENT_TITLE=
INCIDENT_SEVERITY=P2
AFFECTED_SERVICES=payment-service

# ── Judge (evals/factory.py) ──────────────────────────────────────────────────
# LLM-as-judge model + thresholds for the evals harness. The judge model
# must be different from the agent model — using the same model amplifies
# the same biases.
JUDGE_MODEL=claude-sonnet-4-6
JUDGE_PASS_THRESHOLD=0.8
JUDGE_BLOCKING_THRESHOLD=0.5

